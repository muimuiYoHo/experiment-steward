{
  "name": "experiment-steward",
  "version": "0.1.0",
  "description": "Human-approved Flagsmith experiments for AI coding agents: plan, approve, create, start, read results, ship.",
  "type": "module",
  "bin": {
    "steward": "bin/steward.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "steward": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muimuiYoHo/experiment-steward.git"
  },
  "bugs": {
    "url": "https://github.com/muimuiYoHo/experiment-steward/issues"
  },
  "homepage": "https://github.com/muimuiYoHo/experiment-steward#readme",
  "keywords": [
    "flagsmith",
    "feature-flags",
    "experimentation",
    "ab-testing",
    "ai-agents",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^5.9.3"
  }
}
