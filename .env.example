# Copy to .env (git-ignored) or let `node scripts/bootstrap-local.ts` write it for you.
# Never commit real values.
export FLAGSMITH_API_URL=http://localhost:8000
# Organisation (Management) API key, host-scoped like the Flagsmith CLI expects.
# Plain FLAGSMITH_API_KEY also works.
export FLAGSMITH_API_KEY_localhost_8000=<organisation-api-key>
export FLAGSMITH_PROJECT=<project-id>
# Client-side environment key (Development). Used for SDK traffic and environment-scoped API paths.
export FLAGSMITH_ENVIRONMENT_KEY=<client-environment-key>
export FLAGSMITH_ENVIRONMENT=<client-environment-key>
# Optional: route every Management API call through `flagsmith api` (Flagsmith CLI v2)
# STEWARD_TRANSPORT=cli
